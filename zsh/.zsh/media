# "-*- sh -*-"

playlist_duration() {
    for track in $@; do
	ffprobe \
	    -loglevel quiet \
	    -show_entries format=duration \
	    -output_format csv=print_section=0 \
	    $track
    done |
	dm sum 1 |
	sed 's/^/@/' |
	date \
	    --file=- \
	    --utc \
	    +%T
}

go_to_sleep() {
    cd ~/Musique/
    echo "Playlist duration: $(playlist_duration $@)"
    sleep 60
    cvlc --play-and-exit --no-video \
	silence.opus \
	$@ &!
    sleep 1
    set_output_volume.sh iec958-stereo 100%
    set_input_volume.sh application.name VLC 50%
    xset dpms force off
    exit
}

